#!/bin/sh
# Sourced by bin/fountain_server before every command: `start`, the boot-time
# `eval`, and the `rpc` and `remote` an operator runs from a shell. Whatever is
# exported here reaches all of them, which is the point: a remote shell has to
# name the node exactly as the running VM named itself.
#
# Off Fly this file does nothing. Kubernetes names its nodes in the manifest
# (RELEASE_DISTRIBUTION, RELEASE_NODE and RELEASE_COOKIE beside
# CLUSTER_DNS_QUERY, docs/guides/operate/kubernetes.md), and a single machine
# anywhere needs no name at all.
#
# On Fly the node name has to carry the machine's private IPv6 address, and
# fly.toml cannot say that: [env] does not interpolate FLY_PRIVATE_IP, which
# Fly sets on each machine. So the Fly half of clustering lives here.
#
# RELEASE_COOKIE is the switch. A Fly app that sets it clusters; one that does
# not, does not, and runs as one node exactly as before. The cookie is the one
# thing that has to come from the operator either way: without it each node
# reads the cookie baked into its own image, every build bakes a new random
# one, and the old and new machines of a rolling deploy refuse each other.
#
# With the cookie set and CLUSTER_DNS_QUERY unset, peers are found under
# `<app>.internal`, Fly's private DNS name for every started machine of the
# app. It answers with AAAA records only, which libcluster's DNSPoll reads.
# CLUSTER_DNS_QUERY="" keeps the cookie and turns discovery off.
if [ -n "${FLY_APP_NAME:-}" ] && [ -n "${FLY_PRIVATE_IP:-}" ]; then
  if [ -z "${CLUSTER_DNS_QUERY+set}" ] && [ -n "${RELEASE_COOKIE:-}" ]; then
    CLUSTER_DNS_QUERY="${FLY_APP_NAME}.internal"
    export CLUSTER_DNS_QUERY
  fi

  if [ -n "${CLUSTER_DNS_QUERY:-}" ]; then
    # Discovery without a cookie of the operator's own is two islands that
    # look like a cluster in the config. Refuse it rather than boot it.
    if [ -z "${RELEASE_COOKIE:-}" ]; then
      echo "ERROR: CLUSTER_DNS_QUERY is set on Fly, but RELEASE_COOKIE is not." >&2
      echo "Each image bakes its own random cookie, so the machines would never connect." >&2
      echo "Set one with: fly secrets set RELEASE_COOKIE=\$(openssl rand -hex 32)" >&2
      exit 1
    fi

    # 6PN is IPv6 only, so distribution has to listen and dial over inet6.
    case " ${ERL_AFLAGS:-} " in
      *" -proto_dist inet6_tcp "*) ;;
      *) ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-proto_dist inet6_tcp" ;;
    esac
    export ERL_AFLAGS

    # The basename is the release name, fountain_server, which is what
    # config/runtime.exs hands libcluster as the peer basename. An operator
    # who sets either variable keeps it.
    RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
    RELEASE_NODE="${RELEASE_NODE:-${RELEASE_NAME}@${FLY_PRIVATE_IP}}"
    export RELEASE_DISTRIBUTION RELEASE_NODE
  fi
fi
