    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Fresh provisioning",
      "description": "Application preparation span by provider/runtime. Includes attempts that return a failure; not HTTP request-to-ready.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
