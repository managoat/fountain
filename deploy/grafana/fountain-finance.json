    {
      "type": "stat",
      "title": "Untracked sprites",
      "description": "Sprites alive at the provider with no sandbox row to bill against. This is money leaving with nothing to attribute it to. It is a level re-measured on every reaper run, so it falls when they are cleaned up.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_reaper_untracked_count{namespace=\"$namespace\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Usage events dropped",
      "description": "Metering swallows its own failures by contract, so an outage looks exactly like nobody using the product. Any non-zero value here means billing rows were lost over the selected range and the invoice will under-charge (#503).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
