{
  "sdk": "typescript",
  "package": "@managoat/fountain-sdk",
  "directory": "sdk/typescript",
  "verify": "npm run verify-contract",
  "note": "Wire types for the whole document are generated into src/generated/openapi.ts and `npm run generate` proves they are current. What this manifest adds is the hand-written layer above them: the fields run(), the turn follower and the resources reach for by name, which no type check can pin to the wire.",
  "operations": [
    "DELETE /api/agents/{id}",
    "DELETE /api/connection-providers/{id}",
    "DELETE /api/connections/{id}",
    "DELETE /api/conversations/{id}",
    "DELETE /api/environments/{environment_id}/secrets/{id}",
    "DELETE /api/environments/{id}",
    "DELETE /api/sandboxes/{id}",
    "DELETE /api/team/{agent_id}",
    "DELETE /api/team/{agent_id}/schedules/{id}",
    "DELETE /api/vaults/{id}",
    "DELETE /api/vaults/{vault_id}/secrets/{id}",
    "GET /api/agents",
    "GET /api/agents/{id}",
    "GET /api/auth/me",
    "GET /api/catalog",
    "GET /api/connection-providers",
    "GET /api/connection-providers/{id}",
    "GET /api/connections",
    "GET /api/connections/{id}",
    "GET /api/conversations",
    "GET /api/conversations/{conversation_id}/events",
    "GET /api/conversations/{conversation_id}/stream",
    "GET /api/conversations/{conversation_id}/tree",
    "GET /api/conversations/{conversation_id}/turns",
    "GET /api/conversations/{id}",
    "GET /api/environments",
    "GET /api/environments/{environment_id}/secrets",
    "GET /api/environments/{id}",
    "GET /api/events/stream",
    "GET /api/sandboxes",
    "GET /api/sandboxes/{id}",
    "GET /api/sandboxes/{sandbox_id}/diff",
    "GET /api/sandboxes/{sandbox_id}/file",
    "GET /api/sandboxes/{sandbox_id}/files",
    "GET /api/sandboxes/{sandbox_id}/git-status",
    "GET /api/search",
    "GET /api/team",
    "GET /api/team/schedules",
    "GET /api/team/stream",
    "GET /api/team/{agent_id}",
    "GET /api/team/{agent_id}/conversations",
    "GET /api/team/{agent_id}/schedules",
    "GET /api/team/{agent_id}/schedules/{id}",
    "GET /api/vaults",
    "GET /api/vaults/{id}",
    "GET /api/vaults/{vault_id}/secrets",
    "PATCH /api/agents/{id}",
    "PATCH /api/connection-providers/{id}",
    "PATCH /api/conversations/{conversation_id}/labels",
    "PATCH /api/environments/{id}",
    "PATCH /api/team/{agent_id}",
    "PATCH /api/team/{agent_id}/schedules/{id}",
    "PATCH /api/vaults/{id}",
    "PATCH /api/vaults/{vault_id}/secrets/{id}",
    "POST /api/agents",
    "POST /api/connection-providers",
    "POST /api/connection-providers/{id}/discover",
    "POST /api/conversations",
    "POST /api/conversations/{conversation_id}/interrupt",
    "POST /api/conversations/{conversation_id}/prompts",
    "POST /api/conversations/{conversation_id}/read",
    "POST /api/conversations/{conversation_id}/reapply",
    "POST /api/conversations/{conversation_id}/requests/{request_id}",
    "POST /api/conversations/{conversation_id}/terminate",
    "POST /api/environments",
    "POST /api/environments/{environment_id}/secrets",
    "POST /api/team",
    "POST /api/team/{agent_id}/conversations",
    "POST /api/team/{agent_id}/messages",
    "POST /api/team/{agent_id}/schedules",
    "POST /api/team/{agent_id}/schedules/{id}/run",
    "POST /api/vaults",
    "POST /api/vaults/{vault_id}/secrets"
  ],
  "schemas": {
    "Agent": { "required": ["id", "name"] },
    "AgentRequest": {},
    "AgentUpdate": {},
    "AuthMeResponse": { "required": ["id", "email"], "fields": ["connections_enabled", "connections_manageable"] },
    "Block": {
      "required": ["kind"],
      "fields": ["body", "error", "id", "name", "options", "raw", "request_id", "summary", "tool_id"]
    },
    "CatalogResponse": { "required": ["data"] },
    "ChangesetError": { "required": ["errors"] },
    "Connection": {},
    "ConnectionProvider": {},
    "ConnectionProviderRequest": {},
    "Conversation": {
      "required": ["id", "status"],
      "fields": ["agent_id", "environment_id", "sandbox_id", "title", "unread", "vault_id"]
    },
    "ConversationCreateRequest": {
      "required": ["agent_id"],
      "optional": ["channel_id", "environment_id", "fresh", "images", "permission_policy", "prompt", "sandbox_id", "sandbox_mode", "sprite_name", "title", "vault_id"]
    },
    "ConversationListResponse": { "required": ["data"] },
    "ConversationResponse": { "required": ["data"] },
    "ConversationTreeNode": {},
    "Environment": { "required": ["id", "name"] },
    "EnvironmentRequest": {},
    "EnvironmentUpdate": {},
    "Error": { "required": ["error"] },
    "ImageInput": {},
    "LogEvent": {
      "required": ["id", "kind", "ts"],
      "fields": ["blocks", "data", "stage", "state", "stream", "turn_id"]
    },
    "LogEventListResponse": { "required": ["data", "meta"] },
    "PromptRequest": { "required": ["prompt"], "optional": ["images"] },
    "Repository": {},
    "Runner": {},
    "SandboxChange": {},
    "SandboxDetail": { "fields": ["id", "status"] },
    "SandboxDiff": {},
    "SandboxEntry": {},
    "SandboxFile": {},
    "SandboxListing": {},
    "SandboxStatus": {},
    "SearchHit": {},
    "SearchResponse": { "required": ["data", "meta"] },
    "Secret": {},
    "TeamAddRequest": {},
    "TeamSchedule": {},
    "TeamScheduleCreateRequest": {
      "optional": ["enabled", "one_off"]
    },
    "TeamScheduleUpdateRequest": {},
    "Teammate": {},
    "Turn": {
      "required": ["id", "turn_number", "status"],
      "fields": ["exit_code", "prompt"]
    },
    "TurnListResponse": { "required": ["data"] },
    "Vault": { "required": ["id", "name"] },
    "VaultRequest": {},
    "VaultSecretMetadataRequest": { "optional": ["expires_at"] },
    "VaultSecret": {},
    "VaultUpdate": {}
  },
  "enums": {
    "Block.kind": {
      "values": ["error", "init", "permission_request", "raw", "result", "text", "thinking", "tool_result", "tool_use"],
      "exhaustive": true
    },
    "Conversation.status": ["failed", "idle", "pending", "running", "terminated"],
    "LogEvent.kind": { "values": ["output", "stage"], "exhaustive": true },
    "LogEvent.state": ["done", "failed", "interrupted", "started"],
    "Turn.status": ["completed", "failed", "interrupted", "pending", "running"]
  }
}
