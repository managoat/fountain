    "GET /api/team/{agent_id}/schedules/{id}",
    "GET /api/vaults",
    "GET /api/vaults/{id}",
    "GET /api/vaults/{vault_id}/secrets",
    "PATCH /api/agents/{id}",
    "PATCH /api/connection-providers/{id}",
    "PATCH /api/environments/{id}",
    "PATCH /api/team/{agent_id}",
    "PATCH /api/team/{agent_id}/schedules/{id}",
    "PATCH /api/vaults/{id}",
    "POST /api/admin/sandboxes/{id}/reap",
    "POST /api/admin/users/{id}/comp",
    "POST /api/admin/users/{id}/credits",
    "POST /api/admin/users/{id}/role",
    "POST /api/admin/users/{id}/sandbox-limit",
    "POST /api/admin/users/{id}/suspend",
    "POST /api/agents",
    "POST /api/apply",
    "POST /api/auth/api-keys",
    "POST /api/connection-providers",
    "POST /api/connection-providers/{id}/discover",
    "POST /api/conversations",
    "POST /api/conversations/{conversation_id}/interrupt",
    "POST /api/conversations/{conversation_id}/prompts",
    "POST /api/conversations/{conversation_id}/read",
    "POST /api/conversations/{conversation_id}/reapply",
    "POST /api/conversations/{conversation_id}/requests/{request_id}",
    "POST /api/conversations/{conversation_id}/terminate",
    "POST /api/environments",
    "POST /api/environments/{environment_id}/secrets",
    "POST /api/oauth/revoke",
    "POST /api/team",
    "POST /api/team/{agent_id}/conversations",
    "POST /api/team/{agent_id}/messages",
    "POST /api/team/{agent_id}/schedules",
    "POST /api/team/{agent_id}/schedules/{id}/run",
    "POST /api/vaults",
    "POST /api/vaults/{vault_id}/secrets"
  ],
  "schemas": {
    "AuthMeResponse": { "fields": ["connections_enabled", "connections_manageable"] },
    "TurnUsage": { "optional": ["input", "output", "cache_read", "cache_write", "accounting"] },
    "UsageAccounting": { "required": ["version", "source", "scope", "completeness"] },
    "Agent": { "required": ["id", "name"] },
    "AgentListResponse": { "required": ["data"] },
    "AgentResponse": { "required": ["data"] },
    "Block": {
      "required": ["kind"],
      "fields": ["body", "name", "options", "request_id", "summary", "tool_id"]
    },
    "CatalogResponse": { "required": ["data"] },
    "ChangesetError": { "required": ["errors"] },
    "ConnectionListResponse": { "required": ["data"] },
    "ConnectionProviderListResponse": { "required": ["data"] },
    "Conversation": { "required": ["id"], "fields": ["sandbox_api_access", "status"] },
    "ConversationCreateRequest": {
      "required": ["agent_id"],
      "optional": ["channel_id", "environment_id", "fresh", "images", "prompt", "sandbox_api_access", "sandbox_id", "sandbox_mode", "sprite_name", "title", "vault_id"]
    },
    "ConversationListResponse": { "required": ["data"] },
    "ConversationResponse": { "required": ["data"] },
    "ConversationTreeResponse": { "required": ["data"] },
    "Environment": { "required": ["id", "name"], "optional": ["setup_timeout_seconds"] },
    "EnvironmentListResponse": { "required": ["data"] },
    "EnvironmentResponse": { "required": ["data"] },
    "Error": { "required": ["error"] },
    "LogEvent": {
      "required": ["id", "kind"],
      "fields": ["blocks", "data", "stage", "state", "stream", "turn_id"]
    },
    "LogEventListResponse": { "required": ["data", "meta"] },
    "PermissionAnswerRequest": { "required": ["option_id"] },
    "PromptRequest": { "required": ["prompt"], "optional": ["images"] },
    "SandboxDiffResponse": { "required": ["data"] },
    "SandboxFileResponse": { "required": ["data"] },
    "SandboxListResponse": { "required": ["data"] },
    "SandboxListingResponse": { "required": ["data"] },
    "SandboxResponse": { "required": ["data"] },
    "SearchResponse": { "required": ["data"] },
    "SecretListResponse": { "required": ["data"] },
    "SecretRequest": { "required": ["key", "value"] },
    "SecretResponse": { "required": ["data"] },
    "TeamAddRequest": { "required": ["agent_id"] },
    "TeamCommsStatusResponse": { "required": ["data"] },
    "TeamMessageRequest": { "required": ["prompt"], "optional": ["images"] },
    "TeamMessageResponse": { "required": ["conversation_id"] },
    "TeamRenameRequest": { "fields": ["name"] },
    "TeamScheduleListResponse": { "required": ["data"] },
    "TeamScheduleResponse": { "required": ["data"] },
    "Teammate": { "required": ["conversation"] },
    "TeammateConversationListResponse": { "required": ["data"] },
    "TeammateListResponse": { "required": ["data"] },
    "TeammateResponse": { "required": ["data"] },
    "Turn": { "required": ["turn_number"] },
    "TurnListResponse": { "required": ["data"] },
    "Vault": { "required": ["id", "name"] },
    "VaultListResponse": { "required": ["data"] },
    "VaultResponse": { "required": ["data"] },
    "VaultSecretListResponse": { "required": ["data"] },
    "VaultSecretRequest": { "required": ["key", "value"] },
    "VaultSecretResponse": { "required": ["data"] }
  },
  "enums": {
    "ConversationCreateRequest.sandbox_api_access": ["none", "owner"],
    "Conversation.sandbox_api_access": ["none", "owner"],
    "Block.kind": ["error", "init", "permission_request", "raw", "result", "text", "thinking", "tool_use"],
    "Conversation.status": ["failed", "terminated"],
    "LogEvent.kind": { "values": ["output", "stage"], "exhaustive": true },
    "LogEvent.state": {
      "values": ["done", "failed", "interrupted", "started"],
      "exhaustive": true
    }
  }
}
