          "expr": "histogram_quantile(0.95, sum by (provider,runtime,le) (rate(fountain_fresh_provision_stop_duration_bucket{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\"}[$window]))) / 1000",
          "legendFormat": "{{provider}} / {{runtime}} p95"
        }
      ]
