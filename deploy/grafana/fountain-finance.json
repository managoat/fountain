        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Live sandboxes by provider",
      "description": "Non-terminal sandbox rows that are pending, starting or ready. A minute on each provider is bought at a different price, which is why this is tagged by provider and not by tenant. Per-account spend is a database report rather than a series; the console has it under sandbox spend.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (fountain_sandboxes_by_provider_count{namespace=\"$namespace\", status=~\"pending|starting|ready\"})",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Parked sandboxes by provider",
      "description": "Suspended by the idle bound. The sprite is kept so the memory survives (decisions/0017), which means a parked sandbox can still cost storage even though it is doing no work. Only the max-lifetime ceiling destroys.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
