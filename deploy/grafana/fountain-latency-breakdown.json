{
  "title": "Managoat / Latency breakdown",
  "uid": "managoat-latency-breakdown",
  "tags": [
    "managoat",
    "latency",
    "sandboxes"
  ],
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "DS_TEMPO",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(fountain_response_first_text_elapsed_ms_count{namespace=\"fountain\"}, provider)",
          "refId": "provider"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "runtime",
        "label": "Runtime",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(fountain_response_first_text_elapsed_ms_count{namespace=\"fountain\"}, runtime)",
          "refId": "runtime"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "path",
        "label": "Path",
        "type": "custom",
        "query": "cold,warm,wake",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Trace model regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "trend_path",
        "label": "Trend path",
        "type": "custom",
        "query": "cold,warm,wake",
        "current": {
          "text": "cold",
          "value": "cold"
        },
        "options": [
          {
            "text": "cold",
            "value": "cold",
            "selected": true
          },
          {
            "text": "warm",
            "value": "warm",
            "selected": false
          },
          {
            "text": "wake",
            "value": "wake",
            "selected": false
          }
        ]
      },
      {
        "name": "window",
        "label": "Rolling window",
        "type": "custom",
        "query": "5m,10m,20m,1h",
        "current": {
          "text": "20m",
          "value": "20m"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "20m",
            "value": "20m",
            "selected": true
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Where the wait goes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Five exclusive phases from the **same requests**. Every matched sample contributes every phase, including zero when unused; stacked means add to the mean total. Total p50, total p90 and sample counts each have their own chart. Select a **Trend path** and **Rolling window**; provider rows and runtime panels repeat automatically.\n\n**Path** and **Trace model regex** filter only the sampled trace panels below (500-match cap). Continuous metrics have no model filter or trace cap. Outcomes count timed turns; setup failures are separate stage events. Hover panel info for phase boundaries and coverage."
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "${provider} \u00b7 continuous phases \u00b7 $trend_path",
      "repeat": "provider",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "${provider} / ${runtime} \u00b7 $trend_path \u00b7 matched mean phases",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fountain_response_phase_elapsed_ms_sum{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"admission_queue\"}[$window])) / sum(increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"admission_queue\"}[$window]))",
          "legendFormat": "Admission / queue / bookkeeping"
        },
        {
          "refId": "B",
          "expr": "sum(increase(fountain_response_phase_elapsed_ms_sum{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"sandbox\"}[$window])) / sum(increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"sandbox\"}[$window]))",
          "legendFormat": "Sandbox provision / resume"
        },
        {
          "refId": "C",
          "expr": "sum(increase(fountain_response_phase_elapsed_ms_sum{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"bootstrap\"}[$window])) / sum(increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"bootstrap\"}[$window]))",
          "legendFormat": "Bootstrap / reattach preparation"
        },
        {
          "refId": "D",
          "expr": "sum(increase(fountain_response_phase_elapsed_ms_sum{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"runtime_session\"}[$window])) / sum(increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"runtime_session\"}[$window]))",
          "legendFormat": "Runtime / session setup"
        },
        {
          "refId": "E",
          "expr": "sum(increase(fountain_response_phase_elapsed_ms_sum{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"prompt_text\"}[$window])) / sum(increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"prompt_text\"}[$window]))",
          "legendFormat": "Prompt \u2192 first text"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 65,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admission / queue / bookkeeping"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sandbox provision / resume"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bootstrap / reattach preparation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runtime / session setup"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Prompt \u2192 first text"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 210
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "repeat": "runtime",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "description": "Every instrumented request that reaches first assistant text contributes all five phases, including zero for unused phases. Stacked rolling means add to the matched mean request total. Gaps mean no samples. Trend path selects one path; the trace-only model filter does not apply. Sandbox includes provider admission/probe/resume and finalization; Sprites implicit wake can occur in bootstrap. Prompt \u2192 first text includes transport and agent work, not pure model compute."
    },
    {
      "id": 26,
      "type": "row",
      "title": "Continuous totals, sample counts and outcomes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Request \u2192 first text \u00b7 p50 \u00b7 $trend_path",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,provider,runtime) (rate(fountain_response_first_text_elapsed_ms_bucket{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\"}[$window])))",
          "legendFormat": "{{provider}} / {{runtime}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never",
            "axisSoftMax": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "e2b / claude"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "e2b / codex"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sprites / claude"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sprites / codex"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 150
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Total p50 latency by provider/runtime. Provider colors match across both percentile panels; Codex is dashed. No filled areas or stacked series. Both axes start at zero with a shared 30-second baseline and expand if needed to keep larger values visible. Histogram estimates are coarse with few samples. Trace model regex does not apply."
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Request \u2192 first text \u00b7 p90 \u00b7 $trend_path",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (le,provider,runtime) (rate(fountain_response_first_text_elapsed_ms_bucket{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\"}[$window])))",
          "legendFormat": "{{provider}} / {{runtime}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never",
            "axisSoftMax": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "e2b / claude"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "e2b / codex"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sprites / claude"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sprites / codex"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 150
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Total p90 latency by provider/runtime. Provider colors match across both percentile panels; Codex is dashed. No filled areas or stacked series. Both axes start at zero with a shared 30-second baseline and expand if needed to keep larger values visible. Histogram estimates are coarse with few samples. Trace model regex does not apply."
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Matched phase samples per window \u00b7 $trend_path",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,runtime) (increase(fountain_response_phase_elapsed_ms_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\",phase=\"prompt_text\"}[$window]))",
          "legendFormat": "{{provider}} / {{runtime}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 150
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Matched sample count for the five-phase stacks. Low counts make estimates unstable; absence is not zero latency."
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Timed turn outcomes per window \u00b7 $trend_path",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,runtime,status,text) (increase(fountain_response_completed_count{namespace=\"fountain\",provider=~\"${provider:regex}\",runtime=~\"${runtime:regex}\",path=\"$trend_path\"}[$window]))",
          "legendFormat": "{{provider}} / {{runtime}} \u00b7 {{status}} \u00b7 text={{text}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 150
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Terminal outcomes for turns carrying a request clock, including failures and interruptions without text. Rejected requests and provisioning failures before a turn are not included; see setup-stage failures beside this panel."
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Setup / stage failures per window \u00b7 all providers",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (increase(fountain_stage_count{namespace=\"fountain\",status=\"failed\"}[$window]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "height": 150
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Existing durable stage failures include pre-turn provisioning errors. These events lack provider/runtime/path labels and ignore those filters; one request can fail multiple stages. Do not interpret as distinct failed requests."
    },
    {
      "id": 3,
      "type": "row",
      "title": "${provider} \u00b7 sampled trace comparison (two broad phases)",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "repeat": "provider",
      "panels": []
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "$provider / $runtime",
      "description": "Mean phases over the same returned request traces. Blue includes admission/queueing/preparation/wake. Orange includes runtime/session startup and model wait. Each query returns at most 500 traces; failed/no-text requests have no bars. Select a narrower time range if counts reach 500. All charts use a 20-second minimum axis ceiling, expanding for slower requests without clipping.",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 11
      },
      "repeat": "runtime",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"fountain\" && name=\"fountain.turn\" && span.response_first_text_ms >= 0 && span.first_text_ms >= 0 && span.provider =~ \"${provider:regex}\" && span.runtime =~ \"${runtime:regex}\" && span.response_path =~ \"${path:regex}\" && span.effective_model =~ \"${model:raw}\"} | select(span.provider, span.runtime, span.response_path, span.first_text_ms, span.response_first_text_ms, span.effective_model, span.turn_class, span.turn_id)",
          "tableType": "spans",
          "limit": 500,
          "spss": 1
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "response_first_text_ms",
              "operator": "-",
              "right": "first_text_ms"
            },
            "alias": "Before turn"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "traceService": true,
              "traceName": true,
              "spanID": true,
              "time": true,
              "name": true,
              "effective_model": true,
              "provider": true,
              "response_first_text_ms": true,
              "runtime": true,
              "service.name": true,
              "turn_class": true,
              "turn_id": true,
              "duration": true
            },
            "indexByName": {
              "response_path": 0,
              "Before turn": 1,
              "first_text_ms": 2
            },
            "renameByName": {}
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "response_path": {
                "operation": "groupby",
                "aggregations": []
              },
              "Before turn": {
