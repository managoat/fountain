# Every variable the server reads is documented in docs/configuration.md
# (published on the docs site as "Configuration reference"), enforced by a
# test. This file is the local-dev subset plus the self-hosting switches.

# ── Core ─────────────────────────────────────────────────────────────────────

# Database — use docker-compose for local dev: docker compose up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fountain_dev

# Platform master key for envelope encryption (32 bytes, base64url, no padding)
# Generate: openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
MASTER_SECRETS_KEY=

# Required in production when serving. Signs and encrypts session cookies.
# Generate: openssl rand -base64 48
# SECRET_KEY_BASE=

# Externally-visible base URL, absolute and scheme-ful. Used to build links
# that leave the app (verification and reset emails) and passed to
# every sprite as MANAGOAT_BASE_URL, so it must be resolvable from outside.
# An https:// value also switches on HTTPS redirection, HSTS and the secure
# cookie flag. Defaults to http://localhost:4000.
PUBLIC_URL=http://localhost:4000

# Bare host for the endpoint URL and the LiveView check_origin allowlist.
# Derived from PUBLIC_URL when unset, so most setups can leave it blank.
# PHX_HOST=

# PHX_SERVER=true starts the web listener (the shipped image sets it; release
# tasks run with PHX_SERVER=false). PORT is the listen port.
# PHX_SERVER=true
# PORT=4000

# ── Sandboxes ────────────────────────────────────────────────────────────────

# Sprites platform token (never expose to tenants — it pays for every sandbox)
SPRITES_TOKEN=

# Sandbox API endpoint. Anything else must implement the same contract.
# SPRITES_BASE_URL=https://api.sprites.dev

# HTTP timeout for Sprites API calls, in milliseconds. Long-running commands
# (package installs, clones) set their own per-call timeouts.
# SPRITES_TIMEOUT_MS=30000

# Which backend newly-created sandboxes run on: sprites (default) or e2b. A
# provider is enabled by the presence of its credential below; setting a default whose credential is missing fails at
# boot. Existing sandboxes always stay on the provider they were created on.
# SANDBOX_PROVIDER=sprites

# E2B (e2b.dev) — enables the e2b provider when set.
# E2B_API_KEY=
# E2B_BASE_URL=https://api.e2b.app
# E2B_TEMPLATE=base
# E2B_USER=sprite

# Egress credential brokerage (ADR 0019). Every conversation is brokered, and
# a release refuses to boot without both of these. See docs/configuration.md.
# BROKER_LISTEN_PORT runs the proxy inside Managoat; BROKER_PROXY_URL is the
# address a sandbox dials, through an ingress the sandbox provider can reach.
# Dev defaults to 14322 and http://localhost:14322, which a hosted sandbox
# cannot reach: set BROKER_PROXY_URL to run a real conversation from dev.
# BROKER_LISTEN_PORT=14322
# BROKER_PROXY_URL=http://broker.example.com:14322

# Sandbox lifetime bounds: park after this long idle, and an optional ceiling
# on one continuous run (off by default, #936). 0 disables a bound; the
# conversation always stays resumable.
# SANDBOX_IDLE_TIMEOUT_MINUTES=60
# SANDBOX_MAX_LIFETIME_HOURS=0

# ── Registration and accounts ────────────────────────────────────────────────

# Unset (or auto), registration is open only until the instance has an admin,
# then closed to self-registration (ADR 0011). true keeps it open for
# everyone, for good; false closes it from the start. Admins can still open
# accounts (POST /api/admin/users).
# REGISTRATION_ENABLED=true

# There is no switch for the first admin (ADR 0011): while the instance has
# never had an admin, the first account to become verified is promoted,
# audit-recorded. Register before you expose the instance.

# ── Manual ───────────────────────────────────────────────────────────────────

# Where the manual is published. The server does not serve it: /docs, the
# pages under it, /llms.txt, /llms-full.txt and /skill redirect (301) to the
# same path here. Default: https://managoat.com, which publishes the manual
# for `main`. Must be an absolute http(s) URL; a trailing slash is ignored.
# DOCS_URL=https://docs.example.com

# ── Email ────────────────────────────────────────────────────────────────────

# Mail goes out over SMTP, to any server: your own relay or a hosted
# provider's (Resend, for one: smtp.resend.com, port 587, username "resend",
# your API key as the password). Port defaults to 587 and TLS to STARTTLS;
# set SMTP_TLS=never for a relay on a trusted network. Omit the username to
# skip authentication entirely.
#
# Leave SMTP_HOST unset and mail is off: accounts self-verify at registration
# (a verification link that can never arrive gates nothing), and a
# password-reset email cannot be delivered, so a forgotten password is not
# recoverable in-app. Right for one operator; set SMTP before inviting others.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=always

# Required with SMTP_HOST: an address on a domain your provider is verified
# for. Prod refuses to boot without it.
EMAIL_FROM=noreply@fountain.example.com

# Optional: where "contact support" in account emails (deletion)
# points. Unset, the emails say "contact support" with no address.
# SUPPORT_EMAIL=support@example.com

# ── Authentication ───────────────────────────────────────────────────────────

# GitHub OAuth (register at https://github.com/settings/developers). Optional:
# unset, email + password auth still works.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Inference credentials are per-user (BYO, ADR 0008). Set them via
# /account/inference-credentials in the running app, not via env vars.
# (CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY
# all live in the inference_credentials table now.)

# ── Sandbox capacity ─────────────────────────────────────────────────────────
#
# The most live sandboxes across every account, per provider (ADR 0042).
# Each provider is counted on its own against its own ceiling; set each to
# that provider plan's number (Sprites' $20 plan is ~20). The per-provider
# variables default to SANDBOX_FLEET_CEILING. A start past a provider's
# ceiling gets 503 fleet_full; nothing queues.
# SANDBOX_FLEET_CEILING=20
# SANDBOX_FLEET_CEILING_SPRITES=20
# SANDBOX_FLEET_CEILING_E2B=20

# ── Spawn depth ──────────────────────────────────────────────────────────────
#
# How deep a chain of agents starting agents may go. A conversation started
# from outside any sandbox is depth 0; one started from inside a sandbox is
# one deeper than the conversation it came from. A start deeper than this gets
# 422 conversation_depth_exceeded. 0 lets no sandbox start a conversation.
# CONVERSATION_MAX_DEPTH=5

# ── Database TLS and pool ────────────────────────────────────────────────────

# Database TLS. Defaults to on. A stock postgres container does not serve TLS,
# so set this false for the docker-compose setup.
# DATABASE_SSL=false
# Verify the server certificate rather than merely encrypting. Uses the OS trust
# store unless DATABASE_SSL_CA_FILE points at a bundle.
# DATABASE_SSL_VERIFY=true
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/ca.pem
# POOL_SIZE=10

# A release migrates before it serves. Set false to make it only serve, for a
# deployment that runs `bin/migrate` once in a Job instead — that entrypoint
# always migrates, whatever this says. Nothing checks the Job ran: with this
# off and no migration, the app boots and fails on the first query.
# MIGRATE_ON_BOOT=false

# ── Proxies and origins ──────────────────────────────────────────────────────

# CIDRs treated as proxies when resolving the client IP from X-Forwarded-For.
# Required behind a terminating proxy, or per-IP rate limits collapse into one
# bucket keyed on the proxy. Only list genuine proxies.
# TRUSTED_PROXIES=10.0.0.0/8

# Extra origins allowed to open a LiveView websocket (comma-separated). Your
# own host is always included.
# CHECK_ORIGIN_EXTRA=

# Browser origins allowed to call /api with a bearer token from another site
# (comma-separated exact origins, or *). Off when unset. This is what a
# standalone client such as the conversations app needs; cookies are never
# allowed across origins regardless.
# API_CORS_ORIGINS=https://apps.example.com

# Browser apps allowed to "Sign in with Managoat" (OAuth 2.0 code + PKCE,
# public clients). JSON array; redirect URIs match exactly. Pair with
# API_CORS_ORIGINS for the same origins.
# OAUTH_CLIENTS='[{"id":"fountain-conversations","name":"Managoat Conversations","redirect_uris":["https://apps.example.com/fountain-conversations/"]}]'

# ── Observability ────────────────────────────────────────────────────────────

# Prometheus listener (/metrics, /health) on its own private port. Defaults to
# 9568 in prod and off elsewhere; "" or 0 disables.
# METRICS_PORT=9568

# Error tracking. Unset = fully disabled, nothing is sent anywhere. Accepts a
# sentry.io DSN or any Sentry-API-compatible endpoint (e.g. GlitchTip).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Set by the image build; correlates errors and traces with deploys.
# MANAGOAT_BUILD_SHA=

# OpenTelemetry trace export (OTLP over HTTP/protobuf), prod + serving only.
# Off unless the endpoint is set. A vendor that authenticates by header takes
# it in OTEL_EXPORTER_OTLP_HEADERS (Honeycomb: x-honeycomb-team=<key>).
# OTEL_SERVICE_NAME=fountain
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_HEADERS=
