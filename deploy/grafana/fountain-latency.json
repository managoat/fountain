        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,runtime,status) (increase(fountain_turn_completed_duration_ms_count{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\",turn_class=~\"$turn_class\"}[$window]))",
          "legendFormat": "{{provider}} / {{runtime}} / {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed share of terminal turns",
      "description": "Failed divided by all terminal turns per runtime/provider; interrupted turns remain in the denominator. Missing failure series becomes zero only where terminal samples exist.",
