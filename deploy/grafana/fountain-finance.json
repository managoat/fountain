      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (fountain_sandboxes_by_provider_count{namespace=\"$namespace\", status=\"suspended\"})",
          "legendFormat": "{{provider}}",
