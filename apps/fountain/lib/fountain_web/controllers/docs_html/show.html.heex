<div class="max-w-6xl mx-auto px-6 py-10 flex gap-8">
  <aside class="w-56 shrink-0 hidden md:block">
    <nav class="space-y-1 sticky top-6">
      <%!-- #1009: client-side search over titles and headings. The index is
      the whole manual's structure (83 pages, ~700 headings) but not its
      prose — full text would mean inlining the ~737 KB the bodies run to
      after snippet expansion, and "which page is this on" is the question
      headings already answer. `Fountain.Docs.search_index_json/0` builds
      this at compile time; matching and rendering are the only things left
      to do client-side, same reasoning as the copy button below: no asset
      pipeline here, so no separate JS bundle either. --%>
      <div class="relative mb-3" data-role="docs-search">
        <input
          type="search"
          id="docs-search-input"
          placeholder="Search docs…"
          aria-label="Search docs"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="docs-search-results"
          class="w-full rounded-md border border-[var(--color-border)] bg-[var(--color-bg-1)] px-3 py-1.5 text-sm text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]"
        />
        <div
          id="docs-search-results"
          role="listbox"
          class="absolute left-0 right-0 top-full mt-1 hidden max-h-80 overflow-y-auto rounded-md border border-[var(--color-border)] bg-[var(--color-bg-1)] shadow-lg z-10"
        >
        </div>
      </div>
      <%= for {title, item} <- @nav do %>
        <%= if is_list(item) do %>
          <div class="mt-4 mb-2">
            <div class="text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-medium mb-1 px-2">
              {title}
            </div>
            <div class="ml-3 pl-2 border-l border-[var(--color-border)] space-y-1">
              <%= for {child_title, child_slug} <- item do %>
                <a
                  href={docs_path(child_slug)}
                  class={[
                    "block rounded px-3 py-1.5 text-sm hover:bg-[var(--color-bg-2)]",
                    @slug == child_slug &&
                      "bg-[var(--color-bg-2)] font-medium text-[var(--color-text-primary)]",
                    @slug != child_slug && "text-[var(--color-text-secondary)]"
                  ]}
                >
                  {child_title}
                </a>
              <% end %>
            </div>
          </div>
        <% else %>
          <a
            href={docs_path(item)}
            class={[
              "block rounded px-3 py-1.5 text-sm hover:bg-[var(--color-bg-2)]",
              @slug == item &&
                "bg-[var(--color-bg-2)] font-medium text-[var(--color-text-primary)]",
              @slug != item && "text-[var(--color-text-secondary)]"
            ]}
          >
            {title}
          </a>
        <% end %>
      <% end %>
      <a
        href="/api/docs"
        target="_blank"
        class="block rounded px-3 py-1.5 text-sm hover:bg-[var(--color-bg-2)] text-[var(--color-text-secondary)] mt-4"
      >
        API reference (Swagger) ↗
      </a>
    </nav>
  </aside>

  <article class="flex-1 min-w-0 bg-[var(--color-bg-1)] border border-[var(--color-border)] rounded-lg shadow-sm p-8">
    <%!-- The `prose-code:` chip (background, padding, rounding) is for *inline*
    code; Tailwind Typography's `code` variant also matches the `<code>` inside
    a `<pre>`, which paints a light box behind every line of every code block.
    The `[&_pre_code]:` resets below undo it inside a fence, where the
    highlighter's own colours and the block's background are what should show.
    Admonitions arrive as blockquotes (docs/*.md `!!! note`), so the blockquote
    is styled as a note: no italics, no typographic quote marks. --%>
    <div class={[
      "prose prose-zinc dark:prose-invert max-w-none",
      "prose-headings:font-semibold prose-headings:tracking-tight",
      "prose-a:text-blue-600 dark:prose-a:text-indigo-400",
      "prose-pre:bg-[var(--color-code-bg)] prose-pre:text-[var(--color-code-text)] prose-pre:text-xs",
      "prose-code:text-zinc-800 prose-code:bg-zinc-100 dark:prose-code:text-zinc-200 dark:prose-code:bg-zinc-800",
      "prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:font-normal",
      "prose-code:before:content-none prose-code:after:content-none",
      "[&_pre_code]:bg-transparent [&_pre_code]:text-inherit [&_pre_code]:p-0 [&_pre_code]:rounded-none",
      "prose-blockquote:not-italic prose-blockquote:font-normal",
      "[&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none"
    ]}>
      {Phoenix.HTML.raw(@body_html)}
    </div>
  </article>
</div>

<%!-- A copy button on every fenced block, added client-side.

Added because the pages whose point is a script you are meant to take away
(docs/tour.md) need one. The MkDocs site these pages were also published as
got it from Material's `content.code.copy`; this route rendered the same
markdown with no equivalent until #765, and is now the only place they are
published at all (#1008). There is no asset pipeline here — the
layout loads Tailwind and Phoenix from a CDN and everything else is inline —
so this is inline too.

The button is a sibling of the `<pre>`, never a child, so `innerText` cannot
pick up the word "Copy". --%>
<script>
  (() => {
    const article = document.querySelector("article");
    if (!article || !navigator.clipboard) return;

    for (const pre of article.querySelectorAll("pre")) {
      const wrapper = document.createElement("div");
      wrapper.className = "relative group";
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement("button");
      button.type = "button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");
      button.className =
        "absolute top-2 right-2 rounded border border-[var(--color-border)] " +
        "bg-[var(--color-bg-2)] px-2 py-1 text-[11px] leading-none " +
        "text-[var(--color-text-secondary)] opacity-0 transition-opacity " +
        "group-hover:opacity-100 focus:opacity-100 hover:text-[var(--color-text-primary)]";

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          button.textContent = "Copied";
        } catch {
          // Denied permission, or an insecure origin. Say so rather than
          // leaving the button looking like it worked.
          button.textContent = "Press ⌘C";
          const range = document.createRange();
          range.selectNodeContents(pre);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
        }
        setTimeout(() => (button.textContent = "Copy"), 2000);
      });

      wrapper.appendChild(button);
    }
  })();
</script>

<%!-- The search index itself: `Fountain.Docs.search_index_json/0`, computed
once at compile time. `</` is escaped to `<\/` so a heading whose text
happens to contain a literal `</script` (there is none today, but nothing
enforces that) cannot end the element early — the HTML tokenizer looks for
that sequence regardless of `type`. The `<%= %>` is load-bearing: HEEx
treats a `<script>` body as raw text and does not interpolate `{...}`
inside one, so the curly form would render the expression verbatim and
`JSON.parse` would throw. `application/json` keeps it inert;
nothing parses or renders it until the script below reads `textContent`
and calls `JSON.parse`. --%>
<script type="application/json" id="docs-search-index">
  <%= Phoenix.HTML.raw(@search_index_json) %>
</script>

<%!-- Search over the index above: titles and headings, filtered as you
type, keyboard-navigable. No ranking beyond "title matches sort before
page-name-only matches" — the corpus is small enough that substring
matching on ~800 entries is instant, and a fancier score is not worth a
false sense of relevance over 83 pages. --%>
<script>
  (() => {
    const input = document.getElementById("docs-search-input");
    const results = document.getElementById("docs-search-results");
    const indexEl = document.getElementById("docs-search-index");
    if (!input || !results || !indexEl) return;

    const pages = JSON.parse(indexEl.textContent);

    const pagePath = (slug) => (slug === "" ? "/docs" : "/docs/" + slug);

    const entries = [];
    for (const page of pages) {
      entries.push({
        title: page.title,
        page: page.title,
        href: pagePath(page.slug),
        isPage: true,
      });
      for (const heading of page.headings) {
        entries.push({
          title: heading.text,
          page: page.title,
          href: pagePath(page.slug) + "#" + heading.id,
          isPage: false,
        });
      }
    }
    for (const entry of entries) {
      entry.haystack = (entry.title + " " + entry.page).toLowerCase();
    }

    let active = -1;
    let matches = [];

    function search(query) {
      const q = query.trim().toLowerCase();
      if (!q) return [];
      return entries
        .filter((entry) => entry.haystack.includes(q))
        .sort((a, b) => {
          const aTitle = a.title.toLowerCase().includes(q);
          const bTitle = b.title.toLowerCase().includes(q);
          if (aTitle !== bTitle) return aTitle ? -1 : 1;
          return a.haystack.indexOf(q) - b.haystack.indexOf(q);
        })
        .slice(0, 8);
    }

    function render() {
      results.innerHTML = "";

      if (matches.length === 0) {
        results.classList.add("hidden");
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        return;
      }

      matches.forEach((entry, i) => {
        const a = document.createElement("a");
        a.href = entry.href;
        a.id = "docs-search-result-" + i;
        a.setAttribute("role", "option");
        a.className =
          "block px-3 py-2 text-sm no-underline " +
          (i === active
            ? "bg-[var(--color-bg-2)] text-[var(--color-text-primary)]"
            : "text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-2)]");

        const title = document.createElement("div");
        title.className = "font-medium";
        title.textContent = entry.title;
        a.appendChild(title);

        if (!entry.isPage) {
          const sub = document.createElement("div");
          sub.className = "text-xs text-[var(--color-text-muted)]";
          sub.textContent = "in " + entry.page;
          a.appendChild(sub);
        }

        results.appendChild(a);
      });

      results.classList.remove("hidden");
      input.setAttribute("aria-expanded", "true");
      if (active >= 0) {
        input.setAttribute("aria-activedescendant", "docs-search-result-" + active);
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    }

    function close() {
      matches = [];
      active = -1;
      render();
    }

    // A result on the page you are already reading only changes the fragment:
    // no navigation, no unload, and the document click handler never fires for
    // a keyboard Enter — so nothing else would ever close the list. Close it
    // first, then jump.
    function go(href) {
      close();
      window.location.href = href;
    }

    results.addEventListener("click", (event) => {
      const link = event.target.closest("a");
      if (!link) return;
      // Let a modified click do what the browser does with it (new tab, new
      // window) and leave the list alone. A plain one navigates through `go`
      // rather than the anchor's own default, so the list is emptied before
      // the jump instead of during the click's own dispatch.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      go(link.href);
    });

    input.addEventListener("input", () => {
      matches = search(input.value);
      active = matches.length > 0 ? 0 : -1;
      render();
    });

    input.addEventListener("keydown", (event) => {
      // Escape is unconditional: with the list already closed it still has to
      // blur the field. ArrowDown reopens the last results, so it runs on an
      // empty `matches` too — only the wrap-around arithmetic below needs a
      // non-empty list.
      if (event.key === "Escape") {
        close();
        input.blur();
        return;
      }

      if (event.key === "ArrowDown" && matches.length === 0) {
        matches = search(input.value);
        active = matches.length > 0 ? 0 : -1;
        if (matches.length > 0) event.preventDefault();
        render();
        return;
      }

      if (matches.length === 0) return;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        active = (active + 1) % matches.length;
        render();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        active = (active - 1 + matches.length) % matches.length;
        render();
      } else if (event.key === "Enter") {
        const target = matches[active] || matches[0];
        if (target) {
          event.preventDefault();
          go(target.href);
        }
      }
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest('[data-role="docs-search"]')) close();
    });
  })();
</script>
