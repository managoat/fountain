# The directory Mix will write compiled artifacts to.
/_build

# If you run "mix test --cover", coverage assets end up here. Unanchored: in an
# umbrella the reports land in apps/*/cover/ as well as at the root, and while
# the root pattern was anchored a generated excoveralls.json sat committed in
# apps/fountain/cover/ from b1bc89c until #620.
cover/

# Local build outputs (CLI binaries in CI, `mix openapi.export` locally).
/dist

# The directory Mix downloads your dependencies sources to. No trailing slash
# on these: a `dir/` pattern matches a directory only, so a SYMLINK named
# `deps` was not ignored and a `git add -A` in a worktree staged one onto
# main, pointing at a local scratchpad path (#2035).
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp

# Local Git worktrees.
/.worktrees/

# Per-session scratch: briefs, probes and throwaway test files that agents and
# people leave at the root. Not a directory pattern, for the same reason as
# `/deps` above — a `work/` rule matches a directory only, and the symlink was
# the way one of these reached main before (#2035).
/work

# npm state for `scripts/destink`, whose tool is not on main. Installing it
# leaves 5 MB of packages in an otherwise untracked directory, one `git add -A`
# away from the history.
/scripts/destink/node_modules

# ExUnit's `@tag :tmp_dir` writes under the app that runs the test, not the
# umbrella root, and the behavioural CA install test uses one.
apps/*/tmp/

# Database files
*.db
*.db-*

# Built escripts
/aod

# Burrito-wrapped releases (build output)
/burrito_out/

# Environment files
.env
.env.local

# Seed dumps may contain real tokens — never commit
/priv/seeds/*.yaml
/priv/seeds/*.json


# Operator's local AoD manifest — contains MCP bearer tokens.
aod.yml

# Built escript outputs.
/aod
/apps/*/aod

# Burrito output.
/burrito_out/


priv/plts/

# Python (integrations/hermes)
__pycache__/
*.pyc
/sdk/python/build/
/sdk/python/dist/
/sdk/python/src/*.egg-info/


# Swift Package Manager build state.
/.build/
/.swiftpm/
