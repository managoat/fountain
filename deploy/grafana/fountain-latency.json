          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (provider,runtime) (rate(fountain_turn_completed_duration_ms_count{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\",turn_class=~\"$turn_class\",status=\"failed\"}[$window])) or 0 * sum by (provider,runtime) (rate(fountain_turn_completed_duration_ms_count{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\",turn_class=~\"$turn_class\"}[$window]))) / sum by (provider,runtime) (rate(fountain_turn_completed_duration_ms_count{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\",turn_class=~\"$turn_class\"}[$window]))",
          "legendFormat": "{{provider}} / {{runtime}}"
        }
