      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,runtime) (rate(fountain_fresh_provision_stop_duration_sum{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\"}[$window])) / sum by (provider,runtime) (rate(fountain_fresh_provision_stop_duration_count{namespace=~\"$namespace\",provider=~\"$provider\",runtime=~\"$runtime\"}[$window])) / 1000",
          "legendFormat": "{{provider}} / {{runtime}} mean"
